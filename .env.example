# ---------------------------------------------------------------
# Vorlage für die Umgebungsvariablen.
#
# Lokal: diese Datei nach .env.local kopieren (wird nicht eingecheckt).
# Live:  dieselben Werte bei Cloudflare eintragen, unter
#        Workers & Pages → das Projekt → Settings → Variables.
#        Alles außer NEXT_PUBLIC_SITE_URL gehört dort als „Secret"
#        hinterlegt, nicht als einfache Variable.
#
# ⚠️ NEXT_PUBLIC_-Werte werden beim Bauen fest in die Seiten
#    eingebaut. Sie müssen zur Bauzeit gesetzt sein, nicht erst
#    zur Laufzeit — sonst stehen die alten Werte in der Seite.
# ---------------------------------------------------------------

# Die echte Adresse der Website, ohne Schrägstrich am Ende.
# Bis zur Domain-Umstellung die Adresse des Workers eintragen.
NEXT_PUBLIC_SITE_URL=https://www.elektrohofmann.info

# ---------------------------------------------------------------
# Kontaktformular (Resend).
#
# Der Schlüssel entsteht im Resend-Konto unter API Keys. Die
# Absenderdomain elektrohofmann.info muss dort verifiziert sein —
# Resend nennt dafür DNS-Einträge, die in die Cloudflare-Zone
# gehören. Ohne Verifizierung wird jeder Versand abgelehnt.
#
# Fehlt der Schlüssel, läuft die Website normal weiter; nur das
# Formular meldet sich verständlich ab.
# ---------------------------------------------------------------
RESEND_API_KEY=

# Optional. Ohne Angabe wird formular@elektrohofmann.info verwendet.
# Die Empfängeradresse steht nicht hier — sie kommt aus dem Editor
# (content/betrieb.json) und wird beim Bauen übernommen.
ANFRAGE_ABSENDER=

# ---------------------------------------------------------------
# Redaktionssystem (Keystatic) mit GitHub-Anbindung.
#
# Diese vier Werte entstehen beim Einrichten der GitHub-App. Der
# Assistent dafür läuft nur lokal (siehe TERMIN-04-09.md), nicht
# auf der Live-Adresse.
#
# Solange sie fehlen, läuft der Editor im lokalen Modus und kann in
# der Live-Umgebung nichts speichern.
# ---------------------------------------------------------------
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
